generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BbsUser {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       BbsPost[]
  comments    BbsComment[]
}

model BbsPost {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        BbsUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments    BbsComment[]
}

model BbsComment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  postId    Int

  Bbsuser      BbsUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Bbspost      BbsPost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// 過去 
model Cat {
  id          Int     @id @default(autoincrement())
  name        String
  sex         String
  breedId     Int
  birthday    String
  CatImageKey String?
  CatImageUrl String?
  breed       Breed   @relation(fields: [breedId], references: [id], onDelete: Cascade)
}

model Breed {
  id   Int     @id @default(autoincrement())
  name String
  slug String? @unique
  cats Cat[]
}

model CatBlog {
  id                Int              @id @default(autoincrement())
  title             String
  content           String
  thumbnailImageKey String?
  createdAt         DateTime         @default(now()) @map("created_at")
  categoryId        Int?
  ImageUrl          String?
  catBlogCategory   CatBlogCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model CatBlogCategory {
  id      Int       @id @default(autoincrement())
  name    String
  slug    String?   @unique
  catBlog CatBlog[]
}

model CatGoods {
  id         Int           @id @default(autoincrement())
  name       String
  price      Int
  imageKey   String?
  imageUrl   String?
  cartItems  CatCartItem[]
  orderitems OrderItem[]
}

model CatCart {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     CatCartItem[]
}

model CatCartItem {
  id       Int      @id @default(autoincrement())
  cartId   Int
  goodsId  Int
  quantity Int      @default(1)
  cart     CatCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  goods    CatGoods @relation(fields: [goodsId], references: [id], onDelete: Cascade)
}

model CatOrder {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id       Int      @id @default(autoincrement())
  orderId  Int
  goodsId  Int
  quantity Int
  price    Int
  goods    CatGoods @relation(fields: [goodsId], references: [id])
  order    CatOrder @relation(fields: [orderId], references: [id])
}

model Post {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  ImageKey  String?
  ImageUrl  String?
  userId    String?
  comments  Comment[]
  likes     Like[]
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id          String    @id
  email       String?   @unique
  accountName String?
  name        String?
  comments    Comment[]
  likes       Like[]
  posts       Post[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  postId    Int
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  postId    Int
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Event {
  id             Int          @id @default(autoincrement())
  eventTitle     String?
  eventDate      DateTime
  startTime      String?
  ticketImageKey String?
  note           String?
  songList       String?
  rating         Int?
  placeId        Int
  place          Place        @relation(fields: [placeId], references: [id])
  eventImages    EventImage[]
  artist         Artist[]     @relation("ArtistToEvent")
}

model Artist {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  imageUrl String?
  events   Event[] @relation("ArtistToEvent")
}

model Place {
  id     Int     @id @default(autoincrement())
  name   String
  events Event[]
}

model EventImage {
  id      Int     @id @default(autoincrement())
  url     String
  comment String?
  eventId Int
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Pokemon {
  id     Int           @id @default(autoincrement())
  name   String
  weight Int
  detail String        @default("")
  types  PokemonType[]
}

model Type {
  id       Int           @id @default(autoincrement())
  name     String
  pokemons PokemonType[]
}

model PokemonType {
  id        Int     @id @default(autoincrement())
  pokemonId Int
  typeId    Int     @map("type_id")
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type      Type    @relation(fields: [typeId], references: [id], onDelete: Cascade)
}
